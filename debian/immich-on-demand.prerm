#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        if test -z "${DPKG_ROOT:-}" && test -d /run/systemd/system; then
            deb-systemd-invoke --user stop \
                'immich-on-demand@*.service' immich-on-demand.service \
                >/dev/null || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
